{
    admin off
    persist_config off
    auto_https off
    log {
        output stdout
        format console
        level INFO
    }
    servers {
        trusted_proxies static private_ranges
    }
}

:8080 {
    root /opt/indico/static

    @versioned path_regexp static ^/(images|fonts)(.*)/(.+?)(__v[0-9a-f]+)?\.([^.]+)$
    rewrite @versioned /{re.static.1}{re.static.2}/{re.static.3}.{re.static.5}

    @static {
        path /css/*
        path /dist/*
        path /images/*
        path /fonts/*
    }

    handle @static {
        file_server
    }

    handle_errors {
        respond "The server is temporarily unavailable. Please try again later." {err.status_code}
    }

    handle {
        reverse_proxy 127.0.0.1:4321
    }
}